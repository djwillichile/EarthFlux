\deqn{\tau_d = 0.35 - 0.36 \tau_b \ (\tau_b \ge 0.15), \quad
  \tau_d = 0.18 + 0.82 \tau_b \ (\tau_b < 0.15)}{tau_d = 0.35 - 0.36 *
