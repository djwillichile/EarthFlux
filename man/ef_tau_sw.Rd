\deqn{W = 0.14 e_a P + 2.1}{W = 0.14 * ea * P + 2.1}
\deqn{\tau_b = 0.98 \exp\left[\frac{-0.00146 P}{K_t \cos\theta_h} -
  0.075 \left(\frac{W}{\cos\theta_h}\right)^{0.4}\right]}{tau_b = 0.98 *
