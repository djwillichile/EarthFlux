\eqn{r_{ah}}{rah} (see \code{\link[=ef_ustar]{ef_ustar()}}, \code{\link[=ef_rah]{ef_rah()}}) and
\eqn{dT_0 = 0}{dT_0 = 0} (SH-19). At each iteration k:
\enumerate{
\item \eqn{\rho_k}{rho_k} with \code{\link[=ef_air_density]{ef_air_density()}} at
\eqn{T_a = T_s - dT_{k-1}}{Ta = Ts - dT_(k-1)} (SH-08);
\item \eqn{dT_k = H_{target} r_{ah,k-1} / (\rho_k c_p)}{dT_k = H_target *
   rah_(k-1) / (rho_k * cp)} at each anchor;
\item \eqn{a_k, b_k}{a_k, b_k} with \code{\link[=ef_dt_coef]{ef_dt_coef()}};
\item \eqn{H_k = \rho_k c_p (a_k + b_k T_{s,datum}) / r_{ah,k-1}}{H_k =
   rho_k * cp * (a_k + b_k * Ts_datum) / rah_(k-1)} (equal to the target
by construction);
\item Monin-Obukhov length
\eqn{L = -\rho c_p u_*^3 T_s / (k g H)}{L = -rho * cp * u*^3 * Ts /
